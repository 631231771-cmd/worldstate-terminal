# Copy only the values you need to .runtime/worldstate.env or your environment.
# Never commit credentials or proprietary consensus data.

WORLDSTATE_DATABASE_URL=sqlite+aiosqlite:///./.runtime/worldstate.db
WORLDSTATE_DEFAULT_LOCALE=zh-CN
WORLDSTATE_DEFAULT_TIMEZONE=Asia/Shanghai
WORLDSTATE_STRICT_POINT_IN_TIME=true

# Optional official macro provider
FRED_API_KEY=

# Optional evidence-bounded AI report provider
WORLDSTATE_AI_PROVIDER=auto
WORLDSTATE_AI_MODEL=gpt-5.6-sol
WORLDSTATE_AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional local OpenAI-compatible model
OLLAMA_BASE_URL=
WORLDSTATE_OLLAMA_MODEL=qwen3:8b

# Required only when exposing write endpoints beyond the local desktop
WORLDSTATE_WRITE_TOKEN=
