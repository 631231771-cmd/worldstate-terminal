# Desktop default: WorldState.bat creates an ignored .runtime/worldstate.env
# using SQLite. This example shows the optional PostgreSQL/server configuration.
MACRO_ENGINE_URL=http://127.0.0.1:8000
MACRO_DATABASE_URL=postgresql+asyncpg://macro:change-me@127.0.0.1:5432/macro
MACRO_WRITE_TOKEN=
MACRO_DEFAULT_LOCALE=zh-CN
MACRO_DEFAULT_TIMEZONE=Asia/Taipei
FRED_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
DBNOMICS_BASE_URL=https://api.db.nomics.world/v22
MACRO_STRICT_POINT_IN_TIME=true
MACRO_ENABLE_WRITES=false
