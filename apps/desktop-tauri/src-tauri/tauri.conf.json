{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldState Terminal",
  "mainBinaryName": "worldstate-terminal",
  "version": "0.7.0",
  "identifier": "research.worldstate.terminal",
  "build": {
    "beforeDevCommand": "npm --prefix ../terminal-ui run dev",
    "beforeBuildCommand": "npm --prefix ../terminal-ui run build",
    "frontendDist": "../../terminal-ui/dist",
    "devUrl": "http://127.0.0.1:4173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorldState Macro Research Terminal",
        "width": 1500,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": [14, 19, 28, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Finance",
    "shortDescription": "Evidence-bounded macro event and cross-asset research terminal",
    "longDescription": "A local-first terminal for macro releases, event windows, historical comparison and evidence-bounded market explanations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../services/research-api/src": "services/research-api/src",
      "../../../services/research-api/migrations": "services/research-api/migrations",
      "../../../services/research-api/pyproject.toml": "services/research-api/pyproject.toml",
      "../../../services/research-api/alembic.ini": "services/research-api/alembic.ini",
      "../../../services/research-api/uv.lock": "services/research-api/uv.lock",
      "../../../data/fixtures": "data/fixtures",
      "../../../apps/desktop-tauri/src-tauri/bin/worldstate-research-api": "services/research-api-sidecar"
    }
  }
}
